<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <Description>
        Public endpoint for Employee Directory API v1
    </Description>

    <HTTPProxyConnection>
        <BasePath>/v1/employees</BasePath>
        <Properties>
            <Property name="request.payload.parse.limit">30M</Property>
        </Properties>
    </HTTPProxyConnection>


    <FaultRules />
    <DefaultFaultRule />

    <PreFlow name="PreFlow">
        <Request>

            <Step>
                <Name>SpikeArrest.EmployeeDirectory.ControlTraffic</Name>
            </Step>
            <Step>
                <Name>VerifyAPIKey.EmployeeDirectory.VerifyApiKey</Name>
            </Step>
            <Step>
                <Name>Quota.EmployeeDirectory.DailyLimit</Name>
            </Step>

        </Request>
        <Response />
    </PreFlow>

    <Flows />
    <PostFlow />


    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>

</ProxyEndpoint>