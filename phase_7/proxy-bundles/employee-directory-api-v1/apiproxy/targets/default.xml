<TargetEndpoint name="default">
    <Description>
        JSONPlaceholder Employee Backend
    </Description>

    <PreFlow />
    <Flows />
    <PostFlow />
    <EventFlow />

    <HTTPTargetConnection>
        <URL>https://jsonplaceholder.typicode.com/users</URL>
    </HTTPTargetConnection>


    <FaultRules>

        <FaultRule name="BackendError">

            <Step>
                <Name>AssignMessage.EmployeeDirectory.BackendError</Name>
            </Step>

            <Condition>
                response.status.code >= 500
            </Condition>

        </FaultRule>

    </FaultRules>
    <DefaultFaultRule />


    <ScriptTarget />
    <LocalTargetConnection />
</TargetEndpoint>